# Copy to .env. Every KAIROS_<FIELD> below maps to kairos_contracts.wiring.Settings unless marked otherwise.
# Settings.from_env() loads this file (the environment wins), so tests see it too: keep the dev defaults here and use
# the "full stack" block at the end for the demo.

KAIROS_ENV=dev
KAIROS_DATA_DIR=./.data                 # /sovereign-data on the appliance
KAIROS_OKF_DIR=./shared/fixtures/okf    # small frozen test bundle; the demo uses ./data/okf (full stack block)
KAIROS_POLICIES_DIR=./policies
KAIROS_MANIFESTS_DIR=./agents/manifests

KAIROS_DATABASE_URL=postgresql+psycopg://kairos:kairos@localhost:5432/kairos
KAIROS_REDIS_URL=redis://127.0.0.1:6379/0
KAIROS_OLLAMA_URL=http://localhost:11434
KAIROS_DEFAULT_CHAT_MODEL=qwen2.5:7b-instruct
KAIROS_DEFAULT_EMBED_MODEL=nomic-embed-text
KAIROS_MODELS_CONFIG=./models/models.yaml      # 8 GB GPU: ./models/models.7b-only.yaml keeps one chat model loaded

KAIROS_GATEWAY_HOST=0.0.0.0
KAIROS_GATEWAY_PORT=8080
KAIROS_KNOWLEDGE_WATCH=false            # P2: republish manual edits under KAIROS_OKF_DIR as knowledge.changed
KAIROS_DEMO_DATA_URL=postgresql+psycopg://kairos:kairos@localhost:5432/kairos_demo_data   # P1: db tool database (0.12.0); seed with scripts/seed_demo_data.py
KAIROS_FIREWALL_LLM=false               # P2: LLM classifier on unverified/untrusted hits the regex misses (flag instruction_like_llm)

# ---- integration switches: fake | real  (per component, or all at once)
KAIROS_DEFAULT_MODE=fake
# KAIROS_MODE_EVENTS=real      # P1
# KAIROS_MODE_POLICY=real      # P1
# KAIROS_MODE_AUDIT=real       # P1
# KAIROS_MODE_ARTIFACTS=real   # P1
# KAIROS_MODE_SANDBOX=real     # P1 (needs Docker + execution/images/sandbox-base built)
# KAIROS_MODE_TOOLS=real       # P1
# KAIROS_MODE_KNOWLEDGE=real   # P2
# KAIROS_MODE_MEMORY=real      # P2
# KAIROS_MODE_FIREWALL=real    # P2
# KAIROS_MODE_MODELS=real      # P3
# KAIROS_MODE_AGENTS=real      # P3
# KAIROS_MODE_BROWSER=real     # P4
# KAIROS_MODE_CONVERTERS=real  # P4
# KAIROS_MODE_PROBE=real       # P4

# ---- P1 kernel & execution
# mock Jira used by the jira tool. "inprocess" runs it inside kairosd (no docker needed)
KAIROS_JIRA_URL=http://localhost:8090
# KAIROS_EVENTS_REDIS=off                # event history is mirrored to KAIROS_REDIS_URL when Redis answers
# KAIROS_SANDBOX_ENDPOINT=port           # browser sandboxes: "ip" (Linux appliance) | "port" (Docker Desktop, has egress)
# KAIROS_SANDBOX_NETWORK=kairos_sandbox  # internal Docker network for sandboxes (vendor-docs lives there)
# KAIROS_BROWSER_IMAGE=kairos/sandbox-browser:latest
# KAIROS_MCP_CONFIG=./execution/mcp.example.yaml   # MCP servers exposed as tools
# KAIROS_KERNEL_MAX_CONCURRENT_TASKS=2
# KAIROS_KERNEL_APPROVAL_TIMEOUT_S=1800
# KAIROS_KERNEL_ESCALATION_TIMEOUT_S=300 # >0: ask a human before giving up on an agent that exhausted its retries
# KAIROS_KERNEL_MAX_RESTARTS=2           # unfinished tasks are resumed from their root checkpoint after a restart
# KAIROS_KERNEL_RETRY_BACKOFF_S=5        # wait before retrying an agent after a model error (5 s, then 15 s); 0 = at once
# KAIROS_KERNEL_MIN_AGENT_WALL_S=1800    # every agent's wall-time quota is at least this (approvals can take a while)
# KAIROS_KERNEL_POLICY_WATCH_INTERVAL_S=2
# KAIROS_KERNEL_PREEMPTION=true
# KAIROS_KERNEL_SCHEDULES_FILE=./kernel/schedules.example.yaml   # scheduled agents (cron)

# ---- people, orgs and connectors (phase 2; secrets never go in the repo)
# KAIROS_AUTH=dev                        # dev: email sign-in + X-Kairos-User/Org headers (owner of the seeded acme org)
#                                        # google: a Google ID token is exchanged for a session; nothing works without one
# KAIROS_GOOGLE_CLIENT_ID=<web client id>.apps.googleusercontent.com   # Google Cloud console, OAuth web client; add the
#                                        # console's origin (http://localhost:3000) to its authorized JavaScript origins
# KAIROS_VAULT_KEY=<32 random bytes, base64>   # encrypts connector tokens at rest; start-kairosd.ps1 makes one in .data
# KAIROS_SESSION_HOURS=12                # how long a sign-in lasts

# ---- appliance only (read by docker compose via kairosd.service)
# OLLAMA_VERSION=<pinned tag you verified>

# ---- CLI (ai-ps, ai-top, ai-audit ...; not Settings)
# KAIROS_URL=http://localhost:8080        # the gateway the CLI talks to
# KAIROS_USER=alice
# KAIROS_ORG=acme

# ---- outside this file
# console:  apps/web/.env.local  NEXT_PUBLIC_KAIROS_URL=http://localhost:8080   (baked in at `npm run build`)
# compose:  KAIROS_HOST_PORT=8088 docker compose ...   host port for the appliance kairosd when 8080 is taken
# install:  sudo KAIROS_PUBLIC_URL=http://<node>.<tailnet>.ts.net:8080 bash infra/appliance/install.sh

# ---- full stack / demo (Postgres, Redis, Ollama with the models.yaml models, Docker images built)
# KAIROS_DEFAULT_MODE=real
# KAIROS_OKF_DIR=./data/okf
# KAIROS_KNOWLEDGE_WATCH=true            # live invalidation demo (docs/DEMO_SCRIPT.md)
