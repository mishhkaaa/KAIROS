# /etc/systemd/system/kairos-web.service on the appliance (P4 packages, P2 owns apps/web).
# Build first (install.sh does it): cd /opt/kairos/apps/web && npm ci && npm run build
# NEXT_PUBLIC_KAIROS_URL is baked in at build time: set it in apps/web/.env.local to the node's Tailscale URL before building.
[Unit]
Description=KAIROS web console
After=network-online.target kairosd.service
Wants=kairosd.service

[Service]
Type=simple
User=kairos
Group=kairos
WorkingDirectory=/opt/kairos/apps/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -p 3000 -H 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
