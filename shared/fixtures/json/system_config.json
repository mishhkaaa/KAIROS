            ],
            "properties": {
              "path": {
                "type": "string"
              }
            }
          },
          "output_schema": {},
          "risk": "low",
          "reversible": false,
          "requires_sandbox": false
        },
        {
          "name": "write_file",
          "capability": "fs.write",
          "description": "Write a workspace file",
          "input_schema": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            }
          },
          "output_schema": {},
          "risk": "low",
          "reversible": true,
          "requires_sandbox": false
        }
      ]
    },
