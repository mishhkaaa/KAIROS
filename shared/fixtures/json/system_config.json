            "type": "object",
            "required": [
              "sql"
            ],
            "properties": {
              "sql": {
                "type": "string"
              },
              "params": {
                "type": "array"
              }
            }
          },
          "output_schema": {},
          "risk": "high",
          "reversible": false,
          "requires_sandbox": false
        }
      ]
    },
