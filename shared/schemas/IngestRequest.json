      "title": "Target Path",
      "type": "string"
    },
    "options": {
      "additionalProperties": true,
      "title": "Options",
      "type": "object"
    }
  },
  "required": [
    "source_type",
    "uri"
  ],
  "title": "IngestRequest",
  "type": "object"
}
