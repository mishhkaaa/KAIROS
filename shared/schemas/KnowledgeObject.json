{
  "$defs": {
    "OKFFrontmatter": {
      "additionalProperties": true,
      "description": "YAML frontmatter of an OKF Markdown file. Extra keys are allowed (OKF is extensible).",
      "properties": {
        "type": {
          "description": "project | person | team | system | policy | decision | playbook | finance | note | index",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyLevel",
          "default": "internal"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "generator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "unverified"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "trusted"
        },
        "related": {
          "description": "Relative links or /org paths",
          "items": {
            "type": "string"
          },
          "title": "Related",
          "type": "array"
        }
      },
      "required": [
        "type",
        "title"
      ],
      "title": "OKFFrontmatter",
      "type": "object"
    },
    "PrivacyLevel": {
      "description": "Ordered from least to most sensitive. `restricted` must never leave the box.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "PrivacyLevel",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Answers: where did this come from, when was it verified, who/what produced it.",
      "properties": {
        "source": {
          "description": "\"okf\", \"jira\", \"agent:finance\", \"tool:browser\", ...",
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "External id, URL or /org path",
          "title": "Source Ref"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "generator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent/pipeline that produced this",
          "title": "Generator"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "unverified"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "unverified"
        },
        "related_sources": {
          "items": {
            "type": "string"
          },
          "title": "Related Sources",
          "type": "array"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "verified",
        "trusted",
        "unverified",
        "untrusted"
      ],
      "title": "TrustLevel",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "unverified",
        "verified",
        "disputed",
        "stale"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "path": {
      "pattern": "^/org(/[A-Za-z0-9._\\-]+)*/?$",
      "title": "Path",
      "type": "string"
    },
    "okf_file": {
      "description": "Path relative to the bundle root, e.g. projects/apollo.md",
      "title": "Okf File",
      "type": "string"
    },
    "frontmatter": {
      "$ref": "#/$defs/OKFFrontmatter"
    },
    "body": {
      "description": "Markdown body without frontmatter",
      "title": "Body",
      "type": "string"
    },
    "links": {
      "description": "Resolved outgoing links",
      "items": {
        "pattern": "^/org(/[A-Za-z0-9._\\-]+)*/?$",
        "type": "string"
      },
      "title": "Links",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "path",
    "okf_file",
    "frontmatter",
    "body",
    "provenance",
    "content_hash"
  ],
  "title": "KnowledgeObject",
  "type": "object"
}
