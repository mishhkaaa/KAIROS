{
  "$defs": {
    "OKFFrontmatter": {
      "additionalProperties": true,
      "description": "YAML frontmatter of an OKF Markdown file. Extra keys are allowed (OKF is extensible).",
      "properties": {
        "type": {
          "description": "project | person | team | system | policy | decision | playbook | finance | note | index",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyLevel",
          "default": "internal"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "generator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "unverified"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "default": "trusted"
        },
        "related": {
          "description": "Relative links or /org paths",
          "items": {
            "type": "string"
          },
          "title": "Related",
          "type": "array"
        }
      },
      "required": [
        "type",
        "title"
      ],
      "title": "OKFFrontmatter",
      "type": "object"
    },
    "PrivacyLevel": {
      "description": "Ordered from least to most sensitive. `restricted` must never leave the box.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "PrivacyLevel",
      "type": "string"
    },
    "TrustLevel": {
      "enum": [
        "verified",
        "trusted",
        "unverified",
        "untrusted"
      ],
      "title": "TrustLevel",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "unverified",
        "verified",
        "disputed",
        "stale"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Output of a SourceConverter (P4): one OKF file to be written into the bundle by the KnowledgeService (P2).",
  "properties": {
    "okf_file": {
      "description": "Target path relative to the bundle root, e.g. projects/apollo.md",
      "title": "Okf File",
      "type": "string"
    },
    "frontmatter": {
      "$ref": "#/$defs/OKFFrontmatter"
    },
    "body": {
      "description": "Markdown body without frontmatter",
      "title": "Body",
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Original file / issue key / message id",
      "title": "Source Ref"
    }
  },
  "required": [
    "okf_file",
    "frontmatter",
    "body"
  ],
  "title": "OKFDraft",
  "type": "object"
}
