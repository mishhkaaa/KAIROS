          "type": "integer"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/ProcessTreeNode"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "pid",
        "agent",
        "state"
      ],
      "title": "ProcessTreeNode",
      "type": "object"
    }
  },
  "$ref": "#/$defs/ProcessTreeNode"
}
