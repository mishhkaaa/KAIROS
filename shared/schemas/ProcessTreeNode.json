{
  "$defs": {
    "AgentState": {
      "enum": [
        "CREATED",
        "INITIALIZING",
        "READY",
        "RUNNING",
        "WAITING",
        "PAUSED",
        "CHECKPOINTING",
        "COMPLETED",
        "FAILED",
        "RETRYING",
        "TERMINATED"
      ],
      "title": "AgentState",
      "type": "string"
    },
    "ProcessTreeNode": {
