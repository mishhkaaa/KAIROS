{
  "$defs": {
    "AuditEntry": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "default": 0,
          "description": "Monotonic per task; assigned by the AuditLog",
          "title": "Seq",
          "type": "integer"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "task_id": {
          "pattern": "^T-[A-Za-z0-9]+$",
          "title": "Task Id",
          "type": "string"
        },
        "pid": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pid"
        },
        "actor": {
          "description": "\"user:alice\", \"agent:finance-agent#102\", \"kernel.policy\"",
          "title": "Actor",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AuditKind"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "refs": {
          "description": "/org paths, artifact refs, syscall/approval ids",
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "prev_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hash chain for tamper evidence (stretch)",
          "title": "Prev Hash"
        },
        "hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash"
        }
      },
      "required": [
        "entry_id",
        "task_id",
        "actor",
        "kind",
        "summary"
      ],
      "title": "AuditEntry",
      "type": "object"
    },
    "AuditKind": {
      "enum": [
        "task",
        "spawn",
        "state",
        "model",
        "knowledge",
        "memory",
        "ipc",
        "syscall",
        "policy",
        "approval",
        "tool",
        "verify",
        "commit",
        "rollback"
      ],
      "title": "AuditKind",
      "type": "string"
    },
    "TimelineStats": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "default": 0,
          "title": "Agents",
          "type": "integer"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "knowledge_objects": {
          "default": 0,
          "title": "Knowledge Objects",
          "type": "integer"
        },
        "ipc_messages": {
          "default": 0,
          "title": "Ipc Messages",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "privileged_syscalls": {
          "default": 0,
          "title": "Privileged Syscalls",
          "type": "integer"
        },
        "approvals": {
          "default": 0,
          "title": "Approvals",
          "type": "integer"
        },
        "rollbacks": {
          "default": 0,
          "title": "Rollbacks",
          "type": "integer"
        }
      },
      "title": "TimelineStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "pattern": "^T-[A-Za-z0-9]+$",
      "title": "Task Id",
      "type": "string"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/AuditEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "stats": {
      "$ref": "#/$defs/TimelineStats"
    },
    "chain_verified": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "True when the audit log recomputed every entry's hash and each prev_hash links to its predecessor; False when that check fails; None when the log keeps no hash chain",
      "title": "Chain Verified"
    }
  },
  "required": [
    "task_id",
    "goal",
    "entries"
  ],
  "title": "RunTimeline",
  "type": "object"
}
