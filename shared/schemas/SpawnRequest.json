{
  "additionalProperties": false,
  "description": "Body of POST /agents/spawn and the argument of AgentContext.spawn().",
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "task_id": {
      "pattern": "^T-[A-Za-z0-9]+$",
      "title": "Task Id",
      "type": "string"
    },
    "ppid": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ppid"
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "capabilities": {
      "anyOf": [
        {
          "items": {
            "pattern": "^(\\*|[a-z][a-z0-9_]*(\\.([a-z][a-z0-9_]*|\\*))+)$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional narrowing; can never exceed the child's manifest. The parent controls WHICH agents it may spawn (its manifest.capabilities.agents), not their capabilities",
      "title": "Capabilities"
    },
    "scope": {
      "anyOf": [
        {
          "items": {
            "pattern": "^/(org|workspace)(/.*)?$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional narrowing of the child's /org scope (its template's memory mounts); never widens (0.11.0)",
      "title": "Scope"
    },
    "why": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the parent creates this agent, for the audit and the UI",
      "title": "Why"
    }
  },
  "required": [
    "agent",
    "goal",
    "task_id"
  ],
  "title": "SpawnRequest",
  "type": "object"
}
