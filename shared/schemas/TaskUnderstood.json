{
  "additionalProperties": false,
  "description": "task.understood: what the planner took the goal to mean, before it assigns agents.",
  "properties": {
    "intent": {
      "description": "e.g. \"investigate budget overrun and schedule slip\"",
      "maxLength": 240,
      "title": "Intent",
      "type": "string"
    },
    "entities": {
      "description": "e.g. [\"Project Apollo\", \"APOLLO-12\"]",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Entities",
      "type": "array"
    },
    "capabilities_needed": {
      "description": "e.g. knowledge.search, jira.write",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Capabilities Needed",
      "type": "array"
    },
    "plan_summary": {
      "maxLength": 240,
      "title": "Plan Summary",
      "type": "string"
    },
    "goal_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "\"question\", \"data\" or \"investigation\"",
      "title": "Goal Type"
    },
    "router": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What chose the agents: \"laya\" (the decision model) or \"rules\"",
      "title": "Router"
    },
    "route_scores": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Laya's probability that each role is needed",
      "title": "Route Scores",
      "type": "object"
    },
    "route_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How long the routing decision took",
      "title": "Route Ms"
    }
  },
  "required": [
    "intent",
    "plan_summary"
  ],
  "title": "TaskUnderstood",
  "type": "object"
}
